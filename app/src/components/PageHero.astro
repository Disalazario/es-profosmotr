---
/**
 * PageHero — компактный hero для inner-страниц.
 * Хлебные крошки → §-метка → display-заголовок → дек → бэйджи + IsoCube справа.
 */

interface Crumb { label: string; href?: string; }
interface Badge { label: string; tone?: 'brand' | 'muted' | 'ok'; }

interface Props {
  crumbs?: Crumb[];
  kicker: string;
  title: string;
  dek?: string;
  badges?: Badge[];
  showCube?: boolean;
}

const { crumbs = [{ label: 'Главная', href: '/' }], kicker, title, dek, badges = [], showCube = true } = Astro.props;

import IsoCube from './IsoCube.astro';
---
<section class="relative overflow-hidden" style="background: var(--brand-gradient-deep);">
  <div class="bg-iso absolute inset-0 opacity-20 pointer-events-none" aria-hidden="true" style="-webkit-mask-image: linear-gradient(110deg, transparent 0%, transparent 45%, black 100%); mask-image: linear-gradient(110deg, transparent 0%, transparent 45%, black 100%);"></div>

  {/* Хлебные крошки */}
  <nav class="relative border-b" style="border-color: rgba(125,168,255,0.18);" aria-label="Хлебные крошки">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-3 flex items-center gap-2 text-[12px] mono uppercase tracking-wider" style="color: rgba(255,255,255,0.92);">
      {crumbs.map((c, i) => (
        <Fragment>
          {i > 0 && <span style="color: rgba(255,255,255,0.3);">/</span>}
          {c.href ? (
            <a href={c.href} class="hover:text-white transition" style="color: var(--brand-light);">{c.label}</a>
          ) : (
            <span class="text-white">{c.label}</span>
          )}
        </Fragment>
      ))}
    </div>
  </nav>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 sm:py-16 md:py-20">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_auto] gap-12 lg:gap-16 items-center">
      <div class="max-w-3xl">
        <span class="label block mb-4" style="color: var(--brand-light);">{kicker}</span>
        <h1 class="display text-white mb-6" style="font-size: clamp(2rem, 5vw, 3.6rem); line-height: 1.04; letter-spacing: -0.03em;">
          <Fragment set:html={title} />
        </h1>
        {dek && <p class="text-lg sm:text-xl leading-relaxed border-l-2 pl-6 max-w-2xl" style="color: rgba(255,255,255,0.92); border-color: var(--brand-light);">{dek}</p>}

        {badges.length > 0 && (
          <div class="mt-6 flex flex-wrap gap-2">
            {badges.map((b) => {
              const bg = b.tone === 'ok' ? 'rgba(34,197,94,0.12)' : b.tone === 'muted' ? 'rgba(255,255,255,0.05)' : 'rgba(125,168,255,0.12)';
              const bd = b.tone === 'ok' ? 'rgba(34,197,94,0.4)' : b.tone === 'muted' ? 'rgba(255,255,255,0.18)' : 'rgba(125,168,255,0.4)';
              const co = b.tone === 'ok' ? '#86EFAC' : b.tone === 'muted' ? 'rgba(255,255,255,0.88)' : 'var(--brand-light)';
              return (
                <span class="mono text-[11px] uppercase tracking-wider px-3 py-2 rounded-full border" style={`background:${bg}; border-color:${bd}; color:${co};`}>{b.label}</span>
              );
            })}
          </div>
        )}
      </div>

      {showCube && (
        <div class="hidden lg:flex justify-center">
          <div class="w-44 h-44 rounded-2xl border flex items-center justify-center p-4" style="background: rgba(255,255,255,0.04); border-color: rgba(125,168,255,0.18);">
            <IsoCube shape="hex" size="md" mode="orbit" tone="light" />
          </div>
        </div>
      )}
    </div>
  </div>
</section>
