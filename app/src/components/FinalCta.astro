---
/**
 * FinalCta — переиспользуемый CTA-блок в конце inner-страниц.
 */

interface Props {
  kicker?: string;
  title: string;
  dek?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  kicker = '«ЕС-ПРОФОСМОТР»',
  title,
  dek = 'Расскажем про модули, тарифы, сроки подключения. Расчёт под вашу клинику за 5 минут.',
  ctaLabel = 'Получить расчёт',
  ctaHref = 'tel:88006001318',
} = Astro.props;
---
<section class="py-16 sm:py-20 md:py-24 text-white relative overflow-hidden" id="contact" style="background: var(--brand-gradient-deep);">
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="blob-a absolute -top-32 right-1/3 w-96 h-96 rounded-full" style="background: radial-gradient(circle, rgba(125,168,255,0.3), transparent 70%); filter: blur(80px);"></div>
  </div>
  <div class="relative mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
    <span class="label block mb-4" style="color: var(--brand-light);">{kicker}</span>
    <h2 class="display text-white mb-6" style="font-size: clamp(2rem, 5vw, 3.6rem); line-height: 1.05;">
      <Fragment set:html={title} />
    </h2>
    <p class="text-lg mb-8 max-w-2xl mx-auto" style="color: rgba(255,255,255,0.88);">{dek}</p>
    <a href={ctaHref} class="cta-primary inline-flex items-center gap-2 px-8 py-4 rounded-lg text-white font-semibold text-base mb-8">
      {ctaLabel}
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>

    <div class="flex flex-wrap justify-center gap-x-8 gap-y-3 text-sm">
      <a href="tel:88006001318" class="transition hover:text-white" style="color: rgba(255,255,255,0.92);">
        <span style="color: var(--brand-light);">☎</span> 8 (800) 600-13-18
      </a>
      <a href="mailto:sales@apismedia.pro" class="transition hover:text-white" style="color: rgba(255,255,255,0.92);">
        <span style="color: var(--brand-light);">@</span> sales@apismedia.pro
      </a>
      <a href="tel:88125096486" class="transition hover:text-white" style="color: rgba(255,255,255,0.92);">
        <span style="color: var(--brand-light);">☎</span> 8 (812) 509-64-86
      </a>
    </div>
  </div>
</section>
