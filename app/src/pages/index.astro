  <style is:global>
    .quiz-opt input:checked + span {
      background: var(--brand-dark) !important;
      border-color: var(--brand-dark) !important;
      color: #fff !important;
    }
    #quiz-modal.is-open { display: flex !important; }
    body.no-scroll { overflow: hidden; }
  </style>

  <script is:inline>
    (() => {
      const wrap = document.getElementById('logoMarquee');
      const track = document.getElementById('logoTrack');
      if (!wrap || !track) return;
      let offset = 0;
      const step = 320;
      const max = track.scrollWidth / 2;
      wrap.querySelectorAll('[data-dir]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const dir = parseInt(btn.getAttribute('data-dir') || '0', 10);
          offset += dir * step;
          if (offset < -max) offset += max;
          if (offset > 0) offset -= max;
          track.style.transform = `translateX(${offset}px)`;
        });
      });
      let auto;
      const drift = () => { offset -= 0.4; if (offset < -max) offset += max; track.style.transform = `translateX(${offset}px)`; auto = requestAnimationFrame(drift); };
      drift();
      wrap.addEventListener('mouseenter', () => cancelAnimationFrame(auto));
      wrap.addEventListener('mouseleave', () => drift());
    })();

    // ─── Toast ───
    const showToast = (msg, isError) => {
      const t = document.getElementById('toast');
      if (!t) return;
      t.textContent = msg;
      t.classList.toggle('toast--error', !!isError);
      t.classList.add('toast--show');
      clearTimeout(t._hideTimer);
      t._hideTimer = setTimeout(() => t.classList.remove('toast--show'), 4000);
    };

    // ─── Квиз-модал с focus trap, Escape, return focus, loading state ───
    (() => {
      const modal = document.getElementById('quiz-modal');
      const form  = document.getElementById('quiz-form');
      if (!modal || !form) return;

      const FOCUSABLE = 'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';
      let lastTrigger = null;

      const getFocusable = () => Array.from(modal.querySelectorAll(FOCUSABLE)).filter(el => el.offsetParent !== null);

      const open = (e) => {
        lastTrigger = e?.currentTarget || document.activeElement;
        modal.classList.add('is-open');
        document.body.classList.add('no-scroll');
        // Фокус на первый интерактивный элемент
        setTimeout(() => {
          const first = getFocusable()[0];
          if (first) first.focus();
        }, 50);
      };
      const close = () => {
        modal.classList.remove('is-open');
        document.body.classList.remove('no-scroll');
        // Возвращаем фокус на триггер (если жив)
        if (lastTrigger && document.body.contains(lastTrigger)) lastTrigger.focus();
      };

      document.querySelectorAll('[data-quiz-open]').forEach(b => b.addEventListener('click', open));
      document.querySelectorAll('[data-quiz-close]').forEach(b => b.addEventListener('click', close));

      // Focus trap + Escape — только когда модал открыт
      modal.addEventListener('keydown', (e) => {
        if (!modal.classList.contains('is-open')) return;
        if (e.key === 'Escape') { e.preventDefault(); close(); return; }
        if (e.key !== 'Tab') return;
        const focusable = getFocusable();
        if (!focusable.length) return;
        const first = focusable[0];
        const last  = focusable[focusable.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      });

      // Custom validation messages (русский)
      form.querySelectorAll('input[required]').forEach((input) => {
        input.addEventListener('invalid', () => {
          if (input.validity.valueMissing) input.setCustomValidity('Заполните это поле.');
          else if (input.validity.typeMismatch && input.type === 'email') input.setCustomValidity('Введите корректный email, например ivan@clinic.ru');
          else if (input.validity.typeMismatch && input.type === 'tel') input.setCustomValidity('Введите номер телефона.');
          else input.setCustomValidity('');
        });
        input.addEventListener('input', () => input.setCustomValidity(''));
      });

      // Submit — loading state + toast
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const btn = document.getElementById('quiz-submit');
        const label = btn.querySelector('[data-submit-label]');
        const icon = btn.querySelector('[data-submit-icon]');
        const spinner = btn.querySelector('[data-submit-spinner]');
        btn.setAttribute('aria-busy', 'true');
        btn.disabled = true;
        label.textContent = 'Отправляем…';
        icon.classList.add('hidden');
        spinner.classList.remove('hidden');

        const fd = new FormData(form);
        const data = Object.fromEntries(fd.entries());
        data.integrations = fd.getAll('integrations');
        console.log('[quiz]', data);

        // Симуляция запроса (заменить на fetch к бэкенду)
        setTimeout(() => {
          btn.setAttribute('aria-busy', 'false');
          btn.disabled = false;
          label.textContent = 'Получить расчёт';
          icon.classList.remove('hidden');
          spinner.classList.add('hidden');
          form.reset();
          close();
          showToast('Спасибо! Перезвоним в течение 30 минут.');
        }, 700);
      });
    })();
  </script>

</BaseLayout>
