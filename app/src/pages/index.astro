---
import BaseLayout from '../layouts/BaseLayout.astro';
import IsoCube from '../components/IsoCube.astro';

const heroFeatures = [
  // Главное преимущество — ЕГИСЗ отдельным блоком
  { title: 'Интеграция с ЕГИСЗ',       text: 'Передача СЭМД в РЭМД ЕГИСЗ напрямую из МИС', primary: true },
  // Лаборатории и кассы — объединены в один пункт
  { title: 'Лаборатории и кассы',      text: 'ИНВИТРО, Хеликс, КДЛ, Гемотест и онлайн-кассы по 54-ФЗ' },
  // Доработки под клинику — отдельным пунктом
  { title: 'Доработки под клинику',    text: 'Адаптация под процессы и особенности вашей медорганизации' },
  // Шаблоны под актуальные приказы
  { title: 'Приказы 29н и 201н',       text: 'Готовые шаблоны заключений, маршруты осмотров, СЭМД' },
  // Варианты развёртывания
  { title: 'Варианты установки',       text: 'Локальный сервер на ваших мощностях или защищённая виртуальная машина в нашем ЦОД' },
  // Поддержка
  { title: 'Справочная поддержка',     text: 'Вводное онлайн-обучение и помощь без ограничения по времени' },
];

const logos = [
  'ИНВИТРО', 'Биомед', 'МЕДЕРИКА', 'Premier', 'АКОС', 'Wellness Clinic',
  'Здоровье+', 'ПрофМед', 'МедХолдинг', 'СитиМед',
];

const products = [
  {
    key: 'es',
    name: '«ЕС-ПРОФОСМОТР»',
    role: 'МИС для профосмотров',
    text: 'Автоматизация всего комплекса работ по предварительным и периодическим осмотрам сотрудников в соответствии с Приказами 29н от 28.01.2021 и 201н от 14.04.2025.',
    headline: 'Что закрывает система',
    bullets: [
      'Документы и шаблоны осмотров, печать, автозаполнение',
      'Расписание, карты пациентов, маршруты обследований',
      'Учёт патологий, заключительные акты, отчёты по контрагентам',
      'Предварительные, периодические, предрейсовые и предсменные осмотры',
    ],
    cta: { label: 'Подробнее о МИС →', href: '/#es-profosmotr' },
    registry: '№17473',
  },
  {
    key: 'ec',
    name: '«EasyClinic»',
    role: 'МИС для приёмов',
    text: 'Удобный, функциональный и доступный инструмент для всех сотрудников клиники: ведение амбулаторного приёма, регистратура, лаборатория, отчёты.',
    headline: 'Модули программы',
    bullets: [
      'Регистратура: расписание, запись пациентов, СМС-информирование',
      'Приём врача: амбулаторная карта, шаблоны протоколов, МКБ-10',
      'Лаборатория: бланки анализов, результаты, рассылка',
      'Отчёты, ДМС, страховые компании, интеграция с ЕГИСЗ',
    ],
    cta: { label: 'Перейти на easy-clinic.ru ↗', href: 'https://www.easy-clinic.ru/', external: true },
    registry: '№13348',
  },
];

const integrations = [
  {
    title: 'Интеграция с ЕГИСЗ',
    text: 'Передача структурированных электронных медицинских документов в РЭМД ЕГИСЗ напрямую из МИС.',
    listTitle: 'Виды СЭМД — список дополняется',
    items: [
      { tag: '103', name: 'Заключение по результатам предварительного (периодического) МО' },
      { tag: '204', name: 'Медицинское заключение' },
      { tag: '182, 183', name: 'Обратный талон санаторно-курортной карты (для детей)' },
      { tag: '188', name: 'Заключение о допуске на гос. или муниципальную службу' },
      { tag: '228', name: 'Результаты профилактического МО / диспансеризации' },
      { tag: '230', name: 'Медицинское заключение по МО для ЭМЛК' },
      { tag: '196', name: 'Медицинская справка для поступления в вуз' },
    ],
    cta: 'Подробнее об интеграции →',
  },
  {
    title: 'Интеграция с лабораториями',
    text: 'Направления и результаты анализов внешних лабораторий приходят в карту пациента автоматически — без ручного ввода и бумажных бланков.',
    listTitle: 'Подключаемые лаборатории',
    items: [
      { tag: 'Ситилаб',  name: 'Направления и результаты анализов' },
      { tag: 'Хеликс',   name: 'Все типы лабораторных исследований' },
      { tag: 'КДЛ',      name: 'Клинико-диагностические исследования' },
      { tag: 'Гемотест', name: 'Анализы крови, биохимия, гормоны' },
      { tag: 'Инвитро',  name: 'Широкий спектр лабораторных тестов' },
      { tag: 'Литех',    name: 'ПЦР-тесты, инфекционная диагностика' },
    ],
    cta: 'Подробнее о лабораториях →',
  },
  {
    title: 'Интеграция с кассами',
    text: 'Онлайн-кассы по 54-ФЗ, эквайринг и ОФД — прямо из МИС, без отдельной кассовой программы. Чеки формируются автоматически при оплате услуги.',
    listTitle: 'Что подключаем',
    items: [
      { tag: 'АТОЛ',            name: 'Облачные онлайн-кассы по 54-ФЗ' },
      { tag: 'Касса Ethernet',  name: 'Любой фискальный регистратор по сети' },
      { tag: 'Эквайринг',       name: 'Сбер, Тинькофф, СБП, оплата картой и по QR' },
    ],
    cta: 'Подробнее о кассах →',
  },
];

const roles = [
  { name: 'Регистратор и кассир', text: 'Регистратура, касса 54-ФЗ, эквайринг и работа с контрагентами. Полный фронт-офис в одном окне.',
    items: ['Создание карты пациента','Оформление услуг по прайсу контрагента','Касса и эквайринг','Печать документов и согласий','Запись на приём, SMS-напоминания'] },
  { name: 'Менеджер', text: 'Договорная работа: КП, прайсы, реестры и закрывающие документы для корпоративных клиентов.',
    items: ['Прайс-листы по контрагентам','Конструктор коммерческих предложений','Выгрузка реестров и актов','Интеграция с ЕГРЮЛ / ЕГРИП','Загрузка списков сотрудников'] },
  { name: 'Руководитель', text: 'Аналитика, кассовые отчёты, документы для надзорных. Контроль клиники в реальном времени.',
    items: ['Отчёты по контрагентам','Отчёты по сотрудникам','Кассовые отчёты и эквайринг','Заключительные акты, справки','Документы для налоговой'] },
  { name: 'Врач и профпатолог', text: 'Шаблоны осмотров по 29н/201н, автозаполнение, маршрут пациента и СЭМД из карты приёма.',
    items: ['Шаблоны осмотров (29н, 201н)','Автозаполнение документов','Учёт патологий и допуска','Создание СЭМД (103, 196, 204, 230…)','Печать и подпись УКЭП'] },
];

const extras = [
  { name: 'Аккредитация врачей',         text: 'Обучим врачей и средний медицинский персонал.', href: '/licenzia' },
  { name: 'Программа «Честный знак»',    text: 'Позволяет быстро проверять коды маркировки, списывать массово и выравнивать остатки.', href: '/farmvirav' },
  { name: 'Лицензирование мед. учреждений', text: 'Поможем с получением лицензии медицинских организаций, лабораторий, аптек.', href: '/licenziam' },
  { name: 'Программа «МДЛП»',            text: 'Позволяет контролировать срок годности, отслеживать движение и остатки товара, упрощает списание лекарств.', href: '/kontrolpreparatov' },
];

const faq = [
  { q: 'Сколько стоит подключение к «ЕС-Профосмотр»?',           a: 'Тариф зависит от размера клиники и выбранных модулей. Передача СЭМД в ЕГИСЗ — первые 3 месяца бесплатно при подключении. Точную стоимость рассчитаем за 5 минут — оставьте заявку.' },
  { q: 'Подходит ли система частной клинике?',                     a: 'Да. «ЕС-Профосмотр» изначально создан под коммерческие медицинские центры. Все обязательные требования к передаче в ЕГИСЗ закрыты, отчётность для собственника встроена.' },
  { q: 'Какие виды СЭМД передаются в РЭМД ЕГИСЗ?',                 a: 'На текущий момент система формирует и отправляет 8 видов СЭМД: 103 (мед. заключение по результатам предварительного/периодического МО), 204 (мед. заключение), 182, 183 (обратный талон СКК для детей), 188 (заключение о допуске на гос./мун. службу), 228 (профилактический МО / диспансеризация), 230 (мед. заключение по МО для ЭМЛК), 196 (мед. справка для поступления в вуз). Список дополняется.' },
  { q: 'С какими внешними системами интегрируется «ЕС-Профосмотр»?', a: 'Интеграция с ЕГИСЗ (передача СЭМД в РЭМД), лабораториями (передача заявок и получение результатов), базой ЕГРЮЛ, мессенджерами (SMS пациентам), сайтом клиники и агрегаторами расписания. Подключение к 1С и другим внутренним системам — по индивидуальному запросу.' },
  { q: 'Безопасны ли данные пациентов?',                            a: 'Соответствие 152-ФЗ. Серверы в РФ. Шифрование при хранении и передаче. Ролевая модель доступа с журналом действий пользователей.' },
];

// Маленький helper для повторяющегося section-head с IsoCube + §
---
<BaseLayout title="«ЕС-Профосмотр» — МИС для профосмотров и передача СЭМД в ЕГИСЗ">

  {/* ════════ HERO — dark brand gradient, IsoCube, editorial typography ════════ */}
  <section class="relative overflow-hidden text-white" style="background: var(--brand-gradient-deep);">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="blob-a absolute -top-32 -left-32 w-96 h-96 rounded-full" style="background: radial-gradient(circle, rgba(33,103,224,0.5), transparent 70%); filter: blur(60px);"></div>
      <div class="blob-b absolute top-20 -right-20 w-[28rem] h-[28rem] rounded-full" style="background: radial-gradient(circle, rgba(125,168,255,0.35), transparent 70%); filter: blur(80px);"></div>
      <div class="blob-c absolute bottom-0 left-1/3 w-80 h-80 rounded-full" style="background: radial-gradient(circle, rgba(46,115,238,0.3), transparent 70%); filter: blur(60px);"></div>
      <div class="bg-iso absolute inset-0 opacity-30" style="-webkit-mask-image: radial-gradient(ellipse at 70% 30%, black 0%, transparent 60%); mask-image: radial-gradient(ellipse at 70% 30%, black 0%, transparent 60%);"></div>
    </div>

    <div class="relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 pt-12 pb-20 sm:pt-16 sm:pb-24 md:pt-20 md:pb-28 lg:pt-24 lg:pb-32 text-center">

      {/* Брендовый куб APIS — фоновый watermark СТРОГО по центру относительно контента */}
      <div
        class="absolute inset-0 flex items-center justify-center pointer-events-none z-0"
        aria-hidden="true"
        style="--cube-xl: 560px;"
      >
        <div class="opacity-[0.22] w-fit h-fit" style="filter: blur(0.4px);">
          <IsoCube shape="hex" size="xl" mode="orbit" tone="light" />
        </div>
      </div>

      <h1 class="display text-white mx-auto relative z-10" style="font-size: clamp(2rem, 5.4vw, 4.4rem); line-height: 1.02; letter-spacing: -0.03em;">
        <span class="block">Медицинская информационная&nbsp;система</span>
        <em class="not-italic block mt-3 bg-clip-text text-transparent" style="background-image: linear-gradient(110deg, var(--brand-light) 0%, #fff 55%, var(--brand-light) 100%);">«ЕС-ПРОФОСМОТР»</em>
      </h1>

      <p class="text-lg sm:text-xl leading-relaxed mx-auto mt-8 max-w-2xl" style="color: rgba(255,255,255,0.82);">
        Автоматизация медицинского учреждения и&nbsp;передача данных в&nbsp;ЕГИСЗ.
      </p>

      {/* Кнопки в grid 2×: каждая кнопка прижата к внутреннему краю своей колонки → щель ровно по центру (под кубом) */}
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-12 max-w-2xl mx-auto relative z-10">
        <button type="button" data-quiz-open class="cta-primary justify-self-center sm:justify-self-end inline-flex items-center justify-center gap-2 px-8 py-4 rounded-lg text-white font-semibold text-base cursor-pointer">
          Рассчитать стоимость
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <a href="#video" class="justify-self-center sm:justify-self-start inline-flex items-center justify-center gap-2 px-6 py-4 rounded-lg text-white font-medium border transition" style="border-color: rgba(125,168,255,0.3);">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M5 3l8 5-8 5V3z"/></svg>
          Видео о программе
        </a>
      </div>

      {/* 6 пиктограмм-преимуществ — ЕГИСЗ главный, лаб+кассы вместе, доработки отдельно */}
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 mt-16 text-left">
        {heroFeatures.map((f) => (
          <div
            class={`rounded-xl border p-4 backdrop-blur-sm transition ${f.primary ? 'sm:col-span-2 lg:col-span-1' : ''}`}
            style={f.primary
              ? 'background: linear-gradient(135deg, rgba(33,103,224,0.22), rgba(125,168,255,0.10)); border-color: rgba(125,168,255,0.45); box-shadow: 0 0 0 1px rgba(125,168,255,0.18) inset;'
              : 'background: rgba(255,255,255,0.04); border-color: rgba(125,168,255,0.18);'}
          >
            {f.primary && (
              <span class="mono text-[10px] uppercase tracking-wider mb-2 inline-block" style="color: var(--brand-light);">Главное</span>
            )}
            <h3 class="text-white font-semibold text-[15px] mb-2">{f.title}</h3>
            <p class="text-sm leading-snug" style="color: rgba(255,255,255,0.92);">{f.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ════════ LOGOS MARQUEE — paper-2 ════════ */}
  <section class="py-12 sm:py-12" style="background: var(--paper-2); border-bottom: 1px solid var(--brand-dark);">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="text-center label mb-8" style="color: var(--muted);">
        «ЕС-Профосмотр» используют клиники по&nbsp;всей России
      </p>
      <div class="marquee" id="logoMarquee">
        <button class="marquee__btn marquee__btn--prev" aria-label="Назад" data-dir="-1">‹</button>
        <button class="marquee__btn marquee__btn--next" aria-label="Вперёд" data-dir="1">›</button>
        <div class="marquee__track" id="logoTrack">
          <div class="marquee__group">
            {logos.map((name) => (
              <span class="font-bold text-xl whitespace-nowrap transition" style="color: var(--muted);">{name}</span>
            ))}
          </div>
          <div class="marquee__group" aria-hidden="true">
            {logos.map((name) => (
              <span class="font-bold text-xl whitespace-nowrap" style="color: var(--muted);">{name}</span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ════════ PRODUCTS — paper, editorial chapter head ════════ */}
  <section class="py-16 sm:py-20 md:py-24" id="products" style="background: var(--paper); border-bottom: 1px solid var(--brand-dark);">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <header class="grid grid-cols-[80px_1fr] gap-6 mb-12 pb-6 items-start" style="border-bottom: 1px solid var(--brand-dark);">
        <div class="w-16 h-16 flex items-center justify-center border" style="background: var(--surface); border-color: var(--hair-blue); padding: 6px;">
          <IsoCube shape="hex" size="sm" mode="draw" tone="brand" />
        </div>
        <div class="max-w-3xl">
          <span class="label block mb-3" style="color: var(--brand-dark);">§ 02 · ЭПИСМЕДИА</span>
          <h2 class="display text-3xl sm:text-4xl md:text-5xl mb-2 leading-[1.05]" style="color: var(--ink);">
            МИС для&nbsp;профосмотров
            <span class="block" style="color: var(--brand-mid);">и&nbsp;МИС для&nbsp;амбулаторного приёма</span>
          </h2>
          <p class="text-base mt-4" style="color: var(--muted);">
            Два собственных продукта одной команды. Закрывают полный цикл работы медцентра — от&nbsp;регистратуры и&nbsp;приёма до&nbsp;передачи СЭМД в&nbsp;ЕГИСЗ.
          </p>
        </div>
      </header>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        {products.map((p) => (
          <article id={p.key === 'es' ? 'es-profosmotr' : undefined} class="rounded-2xl border p-8 transition flex flex-col" style="background: var(--surface); border-color: var(--hair-blue);">
            <div class="flex items-center justify-between gap-3 mb-6">
              <span class="label" style="color: var(--brand-dark);">{p.role}</span>
              <span class="mono text-[13px] font-semibold px-4 py-2 rounded-md inline-flex items-center gap-2 whitespace-nowrap" style="background: var(--paper-2); color: var(--brand-dark); border: 1px solid var(--hair-blue);">
                <svg width="12" height="12" viewBox="0 0 16 16" fill="none"><path d="M3 8l3 3 7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                Минцифры {p.registry}
              </span>
            </div>
            <h3 class="display text-3xl mb-3" style="color: var(--ink);">{p.name}</h3>
            <p class="leading-relaxed mb-6" style="color: var(--muted);">{p.text}</p>
            <div class="mt-auto">
              <h4 class="label mb-3" style="color: var(--ink);">{p.headline}</h4>
              <ul class="space-y-2 mb-6">
                {p.bullets.map((b) => (
                  <li class="flex gap-2 text-[14px]" style="color: var(--ink-2);">
                    <span class="flex-shrink-0 mt-2 w-1.5 h-1.5 rounded-full" style="background: var(--brand-mid);"></span>
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
              <a
                href={p.cta.href}
                target={p.cta.external ? '_blank' : null}
                rel={p.cta.external ? 'noopener' : null}
                class="inline-flex items-center gap-2 font-semibold text-sm transition-all hover:gap-2"
                style="color: var(--brand-dark);"
              >
                {p.cta.label}
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ════════ INTEGRATIONS — dark brand-deep, light text ════════ */}
  <section class="py-16 sm:py-20 md:py-24 text-white relative overflow-hidden" id="integrations" style="background: var(--brand-gradient-deep);">
    <div class="bg-iso absolute inset-0 opacity-25 pointer-events-none" aria-hidden="true" style="-webkit-mask-image: radial-gradient(ellipse at center, black, transparent 80%); mask-image: radial-gradient(ellipse at center, black, transparent 80%);"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <header class="grid grid-cols-[80px_1fr] gap-6 mb-12 pb-6 items-start" style="border-bottom: 1px solid rgba(125,168,255,0.25);">
        <div class="w-16 h-16 flex items-center justify-center border p-2" style="background: rgba(255,255,255,0.04); border-color: rgba(125,168,255,0.25);">
          <IsoCube shape="hex" size="sm" mode="draw" tone="light" />
        </div>
        <div class="max-w-3xl">
          <span class="label block mb-3" style="color: var(--brand-light);">§ 03 · Интеграции</span>
          <h2 class="display text-3xl sm:text-4xl md:text-5xl text-white mb-4">ЕГИСЗ, лаборатории, кассы</h2>
          <p style="color: rgba(255,255,255,0.92);">
